<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.5005.3"><BatchSequence><Batch><Statements><StmtSimple StatementText="WITH d AS (            -- cộng lượng đã xuất theo từng yêu cầu TRƯỚC khi nối&#xa;    SELECT RequestID, SUM(CAST(DispatchedQty AS BIGINT)) AS DispatchedQty&#xa;    FROM dbo.DispatchOrder GROUP BY RequestID),&#xa;o AS (                  -- phần còn thiếu của từng yêu cầu còn hiệu lực (LEFT JOIN giữ yêu cầu chưa xuất)&#xa;    SELECT r.RequestID, r.RegionID, r.ItemID,&#xa;           r.RequestedQty - ISNULL(d.DispatchedQty, 0) AS Outstanding&#xa;    FROM dbo.ReliefRequest AS r&#xa;    LEFT JOIN d ON d.RequestID = r.RequestID&#xa;    WHERE r.Status IN (&apos;Pending&apos;, &apos;Approved&apos;, &apos;PartiallyDispatched&apos;))&#xa;SELECT RegionID, ItemID, COUNT_BIG(*) AS ActiveRequests, SUM(Outstanding) AS OutstandingQty&#xa;FROM o&#xa;GROUP BY RegionID, ItemID&#xa;ORDER BY RegionID, ItemID" StatementId="4" StatementCompId="269" StatementType="SELECT" StatementSqlHandle="0x090029CA7E059B5A3CCED256F8F28810E2710000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="1" RetrievedFromCache="true" StatementSubTreeCost="2.58537" StatementEstRows="3775.91" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x04B8865A7B7F0FCC" QueryPlanHash="0x3864E8EE4F828384" CardinalityEstimationModelVersion="170"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="1" MemoryGrant="8832" CachedPlanSize="96" CompileTime="6" CompileCPU="6" CompileMemory="704"><MissingIndexes><MissingIndexGroup Impact="10.2464"><MissingIndex Database="[DisasterReliefDB]" Schema="[dbo]" Table="[ReliefRequest]"><ColumnGroup Usage="INEQUALITY"><Column Name="[Status]" Column