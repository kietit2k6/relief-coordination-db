<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.5005.3"><BatchSequence><Batch><Statements><StmtSimple StatementText="WITH agg AS (&#xa;        SELECT r.RegionID, r.RegionName,&#xa;               CASE WHEN r.SeverityLevel = 5 THEN N&apos;Bao dong do&apos; ELSE N&apos;Muc cao&apos; END AS Tier,&#xa;               it.ItemID, it.Unit, ISNULL(SUM(CONVERT(BIGINT, rq.RequestedQty)), 0) AS PendingQty&#xa;        FROM dbo.Region r&#xa;        LEFT JOIN dbo.ReliefRequest rq ON r.RegionID = rq.RegionID AND rq.Status = &apos;Pending&apos;&#xa;        LEFT JOIN dbo.Item AS it ON it.ItemID = rq.ItemID&#xa;        WHERE r.SeverityLevel &gt;= @MinSeverity&#xa;        GROUP BY r.RegionID, r.RegionName, r.SeverityLevel, it.ItemID, it.Unit)&#xa;    SELECT RegionID, ItemID, PendingQty,&#xa;           CASE WHEN ItemID IS NULL&#xa;                THEN CONCAT(RegionName, N&apos; [&apos;, Tier, N&apos;]: chưa có yêu cầu chờ.&apos;)&#xa;                ELSE CONCAT(RegionName, N&apos; [&apos;, Tier, N&apos;], vật phẩm &apos;, ItemID, N&apos;: &apos;, PendingQty, N&apos; &apos;, Unit) END AS Line&#xa;    FROM agg&#xa;    ORDER BY RegionID, ItemID" StatementId="696" StatementCompId="156" StatementType="SELECT" StatementSqlHandle="0x09000084D88F136CBDDD377E9147BA3651550000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="450100644" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="0.103316" StatementEstRows="873.858" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x213315D04F7F6360" QueryPlanHash="0x1277853B66EA527C" StatementOptmEarlyAbortReason="GoodEnoughPlanFound" CardinalityEstimationModelVersion="170"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="1" 