<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.5005.3"><BatchSequence><Batch><Statements><StmtSimple StatementText="WITH d AS (&#xa;    SELECT RequestID, SUM(CAST(DispatchedQty AS BIGINT)) AS DispatchedQty&#xa;    FROM dbo.DispatchOrder GROUP BY RequestID),&#xa;need AS (               -- nhu cầu còn phải cấp theo (RegionID, ItemID)&#xa;    SELECT r.RegionID, r.ItemID, SUM(r.RequestedQty - ISNULL(d.DispatchedQty, 0)) AS OutstandingQty&#xa;    FROM dbo.ReliefRequest AS r&#xa;    LEFT JOIN d ON d.RequestID = r.RequestID&#xa;    WHERE r.Status IN (&apos;Pending&apos;, &apos;Approved&apos;, &apos;PartiallyDispatched&apos;)&#xa;    GROUP BY r.RegionID, r.ItemID),&#xa;stock AS (              -- tồn khả dụng tại chỗ theo (RegionID, ItemID); kho thuộc vùng theo Warehouse.RegionID&#xa;    SELECT w.RegionID, inv.ItemID, SUM(CAST(inv.Quantity - inv.ReservedQty AS BIGINT)) AS LocalAvailable&#xa;    FROM dbo.Inventory AS inv&#xa;    JOIN dbo.Warehouse AS w ON w.WarehouseID = inv.WarehouseID&#xa;    GROUP BY w.RegionID, inv.ItemID),&#xa;m AS (&#xa;    SELECT n.RegionID, n.ItemID, n.OutstandingQty, ISNULL(s.LocalAvailable, 0) AS LocalAvailable,&#xa;           CASE WHEN ISNULL(s.LocalAvailable, 0) &lt; n.OutstandingQty THEN ISNULL(s.LocalAvailable, 0)&#xa;                ELSE n.OutstandingQty END AS CanFulfil&#xa;    FROM need AS n&#xa;    LEFT JOIN stock AS s ON s.RegionID = n.RegionID AND s.ItemID = n.ItemID   -- giữ vùng không có dòng tồn&#xa;    WHERE n.OutstandingQty &gt; 0)&#xa;SELECT m.RegionID, g.RegionName, m.ItemID, i.ItemName, i.Unit,&#xa;       m.OutstandingQty, m.LocalAvailable, m.CanFulfil,&#xa;       m.OutstandingQty - m.CanFulfil AS ShortfallAfterLocal&#xa;FROM m&#xa;JOIN dbo.Region AS g ON g.RegionID = m.RegionID&#xa;JOIN dbo.Item   AS i ON i.ItemID   = m.ItemID&#xa;ORDER BY ShortfallAfterLocal DESC, m.RegionID, m.ItemID" StatementId="2" StatementCompId="133" StatementType="SELECT" StatementSqlHandle="0x09006D3661954F0D994C72E7E12F2FD0DD4B0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="1" RetrievedFromCache="true" StatementSubTreeCost="1.75385" StatementEstRows="1132.77" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x3FE4230104A01C1F" QueryPlanHash="0x92B615FD315D74CD" StatementOptmEarlyAbortReason="TimeOut" CardinalityEstimationModelVersion="170"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="1" MemoryGrant="10664" CachedPlanSize="224" CompileTime="132" CompileCPU="131" CompileMemory="1936"><MissingIndexes><MissingIndexGroup Impact="15.3255"><MissingIndex Database="[DisasterReliefDB]" Schema="[dbo]" Table="[ReliefRequest]"><ColumnGroup Usage="INEQUALITY"><Column Name="[Status]" ColumnId="5"></Column></ColumnGroup><ColumnGroup Usage="INCLUDE"><Column Name="[RegionID]" ColumnId="2"></Column><Column Name="[ItemID]" ColumnId="3"></Column><Column Name="[RequestedQty]" ColumnId="4"></Column></ColumnGroup></MissingIndex></MissingIndexGroup></MissingIndexes><MemoryGrantInfo SerialRequiredMemory="5120" SerialDesiredMemory="10664" RequiredMemory="5120" DesiredMemory="10664" RequestedMemory="10664" GrantWaitTime="0" MaxQueryMemory="989664" GrantedMemory="10664" MaxUsedMemory="3040" LastRequestedMemory="0" IsMemoryGrantFeedbackAdjusted="Yes: Percentile Adjusting"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="81971" EstimatedPagesCached="40985" EstimatedAvailableDegreeOfParallelism="4" MaxCompileMemory="3952200"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-11-22T07:50:20.11" ModificationCount="0" SamplingPercent="100" Statistics="[PKItem]" Table="[Item]" Schema="[dbo]" Database="[DisasterReliefDB]"></St